{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023"], "strict": true, "noUncheckedIndexedAccess": false,
    "rewriteRelativeImportExtensions": true, "allowImportingTsExtensions": false,
    "declaration": true, "outDir": "dist", "rootDir": "src", "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src"]
}
